    {
      "Text": "filter %instruction% on property \"GoalToCallOnFalse\", write to %goalsToCall%",
      "Comment": null,
      "ModuleType": "PLang.Modules.FilterModule",
      "Name": "filter_instruction_on_goal_to_call_on_false",
      "Description": "Take the variable %instruction%, which is expected to be a list or collection of objects, filter these objects by checking their 'GoalToCallOnFalse' property, and write the resulting filtered list into the variable %goalsToCall%.",
      "PrFileName": "09. filter_instruction_on_goal_to_call_on_false.pr",
      "RelativePrPath": ".build\\CodePanel\\FindGoalsToCall\\09. filter_instruction_on_goal_to_call_on_false.pr",
