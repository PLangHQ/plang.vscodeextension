      "RelativeGoalPath": "\\CodePanel.goal",
      "UserIntent": "Add the contents of the variable %goalsToCall% to the list stored in %goalsCouldBeCalled%"
    }
  ],
  "SubGoals": [],
  "Description": "The FindGoalsToCall goal processes each step in the goal's steps. It filters each step based on the 'GoalToCall' property and appends the results to a list of potential goals that could be called. If the step has a non-empty 'RelativePrPath', it reads the corresponding instruction file, filters it for specific properties, and appends the results to the list of goals that could be called.",
  "Visibility": 0,
  "GoalFileName": "CodePanel.goal",
