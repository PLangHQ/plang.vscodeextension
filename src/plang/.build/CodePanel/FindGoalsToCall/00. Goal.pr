    {
      "Text": "filter %step% on property \"GoalToCall\", write to %goalsToCall%",
      "Comment": "- foreach %goal.GoalSteps% call FindGoalsToCall item=%step%",
      "ModuleType": "PLang.Modules.FilterModule",
