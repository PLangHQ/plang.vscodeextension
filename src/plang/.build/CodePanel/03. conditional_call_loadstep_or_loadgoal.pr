  "Text": "if %request.body.lineNumber% != -1 then call LoadStep, else LoadGoal",
  "ModuleType": "PLang.Modules.ConditionalModule",
  "GenericFunctionType": "PLang.Modules.BaseBuilder+GenericFunction",
  "Function": {
    "Reasoning": "The user wants to conditionally call either LoadStep or LoadGoal based on whether the lineNumber in the request body is not equal to -1. This is a simple condition checking inequality, so the SimpleCondition function is appropriate to evaluate this condition and call the respective goals.",
    "Name": "SimpleCondition",
    "Parameters": [
      {
        "Type": "PLang.Modules.ConditionalModule.ConditionEvaluator+SimpleCondition",
        "Name": "condition",
        "Value": {
          "Kind": "Simple",
          "LeftValue": "%request.body.lineNumber%",
          "Operator": "!=",
          "RightValue": -1,
          "IsNot": false
        }
      },
      {
        "Type": "PLang.Models.GoalToCallInfo",
        "Name": "goalToCallIfTrue",
        "Value": {
          "Path": ".build\\CodePanel\\LoadStep\\00. Goal.pr",
          "Name": "LoadStep",
          "Parameters": {}
        }
      },
      {
        "Type": "PLang.Models.GoalToCallInfo",
        "Name": "goalToCallIfFalse",
        "Value": {
          "Path": ".build\\CodePanel\\LoadGoal\\00. Goal.pr",
          "Name": "LoadGoal",
          "Parameters": {}
        }
      }
    ],
    "ReturnValues": null
  },
  "Properties": {
    "Parameters": {
