{
  "Text": "if %step.EventBinding% is not empty then, DisplayEvent, else call DisplayStep",
  "ModuleType": "PLang.Modules.ConditionalModule",
  "GenericFunctionType": "PLang.Modules.BaseBuilder+GenericFunction",
  "Function": {
    "Reasoning": "The user wants to check if %step.EventBinding% is not empty and based on that condition either call DisplayEvent or DisplayStep. The IsNotEmpty function is suitable to check if the variable is not empty and allows specifying goals to call on true or false conditions.",
