        "Value": "%request.body.lineNumber%"
      },
      {
        "Type": "System.String",
        "Name": "propertyToExtract",
        "Value": "parent"
      },
      {
        "Type": "System.String",
        "Name": "retrieveOneItem",
        "Value": "first"
      }
    ],
