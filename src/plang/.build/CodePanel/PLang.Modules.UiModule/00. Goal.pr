    "%request.body.appPath%": "The base path from which the template file will be read.",
    "%goalToCall.Value.Path%": "The specific path of the goal to call, which is used to locate the template file.",
    "%function%": "The function object that is filtered from the instruction.",
    "%function.IsTemplateFile%": "A boolean indicating whether the function is a template file.",
    "%goalToCallPr%": "A variable to store the content read from the template file.",
    "%render%": "A variable to store the rendered template content.",
