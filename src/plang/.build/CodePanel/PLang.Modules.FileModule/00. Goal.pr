  "SubGoals": [],
  "Description": "The PLang.Modules.FileModule goal processes a file based on a specified path. It filters the instruction to obtain the path, constructs an absolute file path using the application path and a relative goal folder path, and then reads the file if the path does not contain a '%' character. If the file is read successfully, it renders a template using the module type derived from the step.",
  "Visibility": 0,
  "GoalFileName": "CodePanel.goal",
  "PrFileName": "00. Goal.pr",
  "RelativeGoalPath": "\\CodePanel.goal",
  "RelativeGoalFolderPath": "\\",
