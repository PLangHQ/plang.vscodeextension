      "Comment": null,
      "ModuleType": "PLang.Modules.FilterModule",
      "Name": "filter_instruction_for_path_and_get_first_parent",
      "Description": "Apply a filter on the %instruction% variable to find entries where the nested property Function.Parameters.Name equals 'path'. From these filtered entries, get their parent elements, select the first such parent entry, and assign this to the %path% variable for further use.",
