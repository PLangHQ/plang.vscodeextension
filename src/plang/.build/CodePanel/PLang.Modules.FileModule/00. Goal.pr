  "IncomingVariablesRequired": {
    "%instruction%": "The instruction containing the parameters to filter for the file path.",
    "%request.body.appPath%": "The application path from the request body used to construct the absolute file path.",
    "%goal.RelativeGoalFolderPath%": "The relative folder path associated with the goal to complete the absolute file path.",
    "%path.Value%": "The value of the path that is being processed, which should not contain a '%' character to proceed with file reading.",
    "%content%": "The variable where the content of the file will be written after reading.",
    "%module%": "The variable where the rendered template will be written."
  },
